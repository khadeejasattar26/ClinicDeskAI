# Copy to .env. npm dev and seed read this file. Never commit .env.
# NODE_ENV=development  # Backend defaults to development; Docker/Render set production.
PORT=3001
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# 0 for direct local connections; 1 behind Render's single trusted proxy.
TRUST_PROXY_HOPS=0
# Deterministic AI, no OpenAI key needed. Independent of database mode.
MOCK_LLM=true
# In-memory, auto-seeded local demo. MUST be false in production.
DEMO_MODE=true
# Required when DEMO_MODE=false. Service role stays on the server only.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required only when MOCK_LLM=false.
# OPENAI_API_KEY=your-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# USD per million tokens; set current provider prices for your selected models.
# Zero means unconfigured cost estimate; the dashboard labels this explicitly.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
OPENAI_EMBEDDING_COST_PER_MILLION=0
# Missing key logs email previews locally; production delivery needs verified sender.
# RESEND_API_KEY=your-key
EMAIL_FROM=CareWell <appointments@example.com>
# Replace with a random secret of at least 24 characters before deploying.
CRON_SECRET=local-demo-cron-secret-change-me
# 20 requests/min per IP. Raise ONLY in isolated mock load tests.
CHAT_RATE_LIMIT=20
# Public browser variables. Never put the service role key here.
VITE_API_URL=
VITE_CLINIC_ID=11111111-1111-4111-8111-111111111111
VITE_DEMO_MODE=true
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Used by seed in Supabase mode. Set your own values; password is not hardcoded.
# SEED_STAFF_EMAIL=staff@example.com
# SEED_STAFF_PASSWORD=choose-a-long-unique-password
# Vite reverse proxy, mainly for Docker Compose.
VITE_PROXY_TARGET=http://127.0.0.1:3001
